#!/bin/bash
# Adaptador reproducible para ejecutar unicamente Apps_MATVEC_3D_STENCIL/Base_OpenMP
# y convertir el checksum nativo de RAJAPerf en el success_check del catalogo.
# Generado para la prueba sellada V1, ronda 2 (politica CPU memory-bound,
# 2026-09-22): los candidatos de la ronda 1 fuera de Algorithm_/Apps_/Comm_
# resultaron ser la misma familia ya usada en entrenamiento (rajaperf_basic/
# lcals/polybench via patron de familia), asi que esta ronda se restringe a
# nombres que SI generan familia nueva.
set -euo pipefail

binary="/home/latorresn/hyperion-kernels/libexec/raja-perf-v2025.12.1"
expected_binary_sha256="7f5251ac4c8f4bfd854441b7873f120080affec7bc77abfce1cc0fb9ec165ebb"

actual_binary_sha256="$(sha256sum "$binary" | awk '{print $1}')"
if [[ "$actual_binary_sha256" != "$expected_binary_sha256" ]]; then
  echo "RAJAPerf binary checksum mismatch" >&2
  exit 1
fi

run_dir="$(mktemp -d -p /home/latorresn/yacacerest hyperion_cpu_rajaperf_apps_matvec_3d_stencil_run_XXXXXX)"
cleanup() {
  rm -rf -- "$run_dir"
}
trap cleanup EXIT

export OMP_NUM_THREADS=6
export OMP_PROC_BIND=true
export OMP_PLACES=cores

cd "$run_dir"
"$binary" --warmup-disable -k Apps_MATVEC_3D_STENCIL -v Base_OpenMP "$@"

if ! grep -Eq '^Base_OpenMP-default[[:space:]]+PASSED' RAJAPerf-checksum.txt; then
  echo "RAJAPerf Apps_MATVEC_3D_STENCIL checksum failed" >&2
  exit 1
fi

grep -E '^Base_OpenMP-default[[:space:]]+PASSED' RAJAPerf-checksum.txt
echo "Verification = SUCCESSFUL"
