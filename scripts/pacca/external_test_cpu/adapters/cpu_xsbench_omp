#!/bin/bash
# Adaptador de XSBench (ANL-CESAR/XSBench, openmp-threading, commit ba08e5221af6106252b866e50ea123c69d31a4e2) para el catalogo:
# comprueba el checksum del binario compilado en paccaA100 y convierte la verificacion nativa
# ("Verification checksum: N (Valid)") en el success_check del catalogo.
set -euo pipefail

binary="/home/latorresn/hyperion-kernels/libexec/xsbench/XSBench"
expected_binary_sha256="8007d5693b9f501fda59594416054c20bda8012d2c1305613d52d1ea5007c486"

actual_binary_sha256="$(sha256sum "$binary" | awk '{print $1}')"
if [[ "$actual_binary_sha256" != "$expected_binary_sha256" ]]; then
  echo "XSBench binary checksum mismatch" >&2
  exit 1
fi

export OMP_NUM_THREADS=6
export OMP_PROC_BIND=true
export OMP_PLACES=cores

out="$("$binary" "$@" 2>&1)"
echo "$out"
if ! grep -Eq 'Verification checksum: [0-9]+ \(Valid\)' <<<"$out"; then
  echo "XSBench verificacion fallo" >&2
  exit 1
fi
echo "Verification = SUCCESSFUL"
